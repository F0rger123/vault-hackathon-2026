FROM python:3.11-slim
WORKDIR /app
RUN useradd --create-home --uid 10001 vault
COPY pyproject.toml README.md ./
COPY backend ./backend
COPY cli ./cli
COPY generator ./generator
COPY evaluation ./evaluation
# setuptools is only needed to install; removing it drops its vendored copies of wheel and jaraco.context,
# which image scans flag (docs/SECURITY.md).
RUN pip install --no-cache-dir . && pip uninstall -y setuptools \n    && mkdir -p /data && chown vault:vault /data
USER vault
ENV VAULT_DATA_DIR=/data
EXPOSE 8000
CMD ["uvicorn", "backend.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
