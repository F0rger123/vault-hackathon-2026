# Copy to .env and adjust. Never commit .env.
# Where VAULT stores its database, read-only originals and exports.
VAULT_DATA_DIR=data/runtime
VAULT_MAX_UPLOAD_MB=50

# Server directories an admin may import from by path (comma separated). Empty disables path import.
VAULT_IMPORT_ROOTS=

# Default model provider: ollama (local Meta open-weight model) | meta_api (Meta Model API, remote) | heuristic
VAULT_PROVIDER=ollama
VAULT_OLLAMA_URL=http://127.0.0.1:11434
# llama3:latest (8B) fits 8 GB GPUs. muse-glimmer:30b needs roughly 18-24 GB of VRAM/RAM.
VAULT_OLLAMA_MODEL=llama3:latest

# Meta Model API (https://api.meta.ai/v1). Sends document text off this machine.
# Avoid *-contributor models: Meta may train on their inputs.
VAULT_META_API_MODEL=muse-spark-1.3
VAULT_META_API_KEY=
# Remote inference stays blocked unless this is true (an admin can also toggle it in the API).
VAULT_ALLOW_REMOTE_INFERENCE=false

VAULT_MAX_WORKERS=0
# Workers hold back new documents while free RAM is below this floor (MB), for up to VAULT_MEMORY_WAIT_S seconds.
VAULT_MIN_FREE_MEMORY_MB=256
# Reuse earlier model answers for unchanged documents in processing jobs (development runs only).
VAULT_RESPONSE_CACHE=false
# One-click Demo sign-in buttons. Only for a laptop showing fictional data; never on a shared server.
VAULT_DEMO_LOGIN=false
VAULT_SESSION_TTL_HOURS=12
# Host names the API answers to (blocks DNS rebinding). Add yours if you serve VAULT under another name.
VAULT_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
VAULT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_VAULT_API=http://127.0.0.1:8000
