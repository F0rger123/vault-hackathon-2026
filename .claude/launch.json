{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vault-api",
      "runtimeExecutable": ".venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["backend.main:create_app", "--factory", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "vault-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    }
  ]
}
